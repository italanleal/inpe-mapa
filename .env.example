# Copie para .env e preencha os valores. Carregado automaticamente por scripts/scrape_inpe.py e producer/main.py
# (variáveis já exportadas no terminal e flags de linha de comando têm prioridade).
AWS_PROFILE=inpe-producer
AWS_DEFAULT_REGION=sa-east-1
S3_BUCKET=preencha-com-output-BucketName
S3_KEY=consolidated/dataset.csv
SQS_QUEUE_URL=https://sqs.sa-east-1.amazonaws.com/ACCOUNT/QUEUE.fifo
TABLE_NAME=preencha-com-output-TableName
H3_RESOLUTION=5
READ_INTERVAL_SECONDS=1
DATA_DIR=data
